; Engine configuration file.
; PHAROS — La última luz (see ../README.md)

config_version=5

[application]

config/name="Pharos"
config/description="La última luz: defensa de una isla griega contra las criaturas de Nyx."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.07, 0.12, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout=""

[autoload]

Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/EBGaramond-Medium.ttf"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.12, 1)

[shader_globals]

g_amb_sky={
"type": "vec3",
"value": Vector3(0.45, 0.55, 0.75)
}
g_amb_ground={
"type": "vec3",
"value": Vector3(0.35, 0.3, 0.22)
}
g_fog_color={
"type": "vec3",
"value": Vector3(0.6, 0.75, 0.85)
}
g_fog_near={
"type": "float",
"value": 60.0
}
g_fog_far={
"type": "float",
"value": 180.0
}
g_sun_comp={
"type": "float",
"value": 1.0
}
g_night={
"type": "float",
"value": 0.0
}
g_time={
"type": "float",
"value": 0.0
}
g_sun_dir={
"type": "vec3",
"value": Vector3(0.4, 0.7, 0.3)
}
g_sun_color={
"type": "vec3",
"value": Vector3(1.0, 0.9, 0.75)
}
g_window={
"type": "vec3",
"value": Vector3(1.0, 0.62, 0.25)
}
g_water_shallow={
"type": "vec3",
"value": Vector3(0.08, 0.66, 0.62)
}
g_water_deep={
"type": "vec3",
"value": Vector3(0.008, 0.08, 0.2)
}
g_foam={
"type": "vec3",
"value": Vector3(0.92, 0.96, 0.96)
}
g_sky_top={
"type": "vec3",
"value": Vector3(0.25, 0.5, 0.85)
}
g_sky_horizon={
"type": "vec3",
"value": Vector3(0.7, 0.85, 0.95)
}
g_moon_dir={
"type": "vec3",
"value": Vector3(-0.3, 0.6, -0.5)
}
g_wind={
"type": "float",
"value": 1.0
}
g_water_tex={
"type": "sampler2D",
"value": ""
}
g_water_rect={
"type": "vec4",
"value": Vector4(-110, -110, 220, 220)
}
