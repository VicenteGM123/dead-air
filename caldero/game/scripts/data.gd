	# Lupo, el pescador
	{"who": "lupo", "potion": "elixir_alba",
		"text": "Me caí al lago persiguiendo una lágrima de sirena. Ahora tengo un resfrío que suena a foca.",
		"hint": "Calor y vida.",
		"plan": "Me la tomo con un caldo de pescado, como manda la tradición.",
		"good": "¡El resfrío se fue! Ya no sueno a foca. Bueno, a foca contenta, como mucho.",
		"fail": "Sigo sonando a foca. Las focas de verdad me contestan."},
	{"who": "lupo", "potion": "ojo_nocturno",
		"text": "Las mejores lágrimas de sirena aparecen antes del amanecer, cuando todavía no se ve nada. ¿Me ayudas a ver en lo oscuro?",
