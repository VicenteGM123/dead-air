class_name MeadowPaint
## The painted textures of the wheat field and the meadow's far billboards (DOCE), generated by code at startup
## (cached): brush strokes rasterised into RGBA8 images. They store painting DATA, not colours: the shaders turn it
## into colour with the field's palette (shaders/wheat_lib.gdshaderinc), the mound pattern, the wind and the light,
## so one texture serves the day and the night.
##
## card_atlas()  1024 x 384, side views of wheat for the camera-facing ear cards and the field's edge cards
##               (shaders/wheat_ears.gdshader, modes 1 and 2). Only the wheat tiles are painted:
##   tile 4  (  0, 160) 256 x 192  wheat: stalks, leaves, nodding ears with grains and long awns
##   tile 5  (256, 160) 256 x 192  wheat, second variant (denser)
##   tile 7  (768, 160) 256 x 192  wheat edge: a ragged, thinner stand (field edges and the verges of the field)
##   (tiles 0-3 and 6 are left empty: the anime meadow is built from 3D clumps, not cards)
##   R  height in the tile (0 bottom .. 1 top)
##   G  shade / grain: 0 = the back of the stand (deep, shaded) .. 1 = the front (lit); the grain rows of the ears
##   B  part: 0 stalk, 0.33 leaf, 0.66 ear, 1 awn
##   A  coverage (soft 1.5 px edge: the shaders cut at 0.5 and stay smooth when magnified)
## wheat_top()   256 x 256 tiling, the wheat's ear canopy seen from above (shaders/wheat_canopy.gdshader): dense
##   ears (segmented spindles combed to +u) and awns. R position along the ear, G grain / shade, B part (0.66 ear,
##   1 awn), A coverage.
## Canvas        the brushes (also used by MeadowKit.billboard_texture for the meadow's far billboard clumps).

const ATLAS_W := 1024
const ATLAS_H := 384
## Tile rects in the atlas (pixels).
const TILES := [
	Rect2i(0, 0, 256, 160), Rect2i(256, 0, 256, 160), Rect2i(512, 0, 256, 160), Rect2i(768, 0, 256, 160),
	Rect2i(0, 160, 256, 192), Rect2i(256, 160, 256, 192), Rect2i(512, 160, 256, 192), Rect2i(768, 160, 256, 192),
]

static var _cache := {}


## Atlas UV rect (x, y, w, h in 0..1) of tile i.
static func tile_uv(i: int) -> Vector4:
	var r: Rect2i = TILES[i]
	return Vector4(float(r.position.x) / ATLAS_W, float(r.position.y) / ATLAS_H, float(r.size.x) / ATLAS_W, float(r.size.y) / ATLAS_H)


static func card_atlas() -> ImageTexture:
	if _cache.has("atlas"):
		return _cache["atlas"]
	var c := Canvas.new(ATLAS_W, ATLAS_H)
	_wheat(c, TILES[4], 1505, 30)
	_wheat(c, TILES[5], 1606, 38)
	_wheat(c, TILES[7], 1808, 16)
	var tex := c.texture()
	_cache["atlas"] = tex
	_cache["atlas_img"] = c.image()
	return tex


static func wheat_top() -> ImageTexture:
	if _cache.has("wheat_top"):
		return _cache["wheat_top"]
	var c := Canvas.new(256, 256)
	c.fill(Color(0, 0, 0, 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = 3301
	for i in 430:
		var p := Vector2(rng.randf() * 256.0, rng.randf() * 256.0)
		var ang := rng.randf_range(-0.55, 0.55)
		var L := rng.randf_range(19.0, 27.0)
		var dir := Vector2(cos(ang), sin(ang))
		for k in 4:
			var s := rng.randf_range(0.4, 0.95)
			var a2 := ang + rng.randf_range(-0.4, 0.4)
			c.line_wrap(p + dir * L * s, a2, rng.randf_range(9.0, 16.0), 0.6, Color(1.0, 0.85, 1.0, 1.0))
		c.ear_top(p, ang, L, rng.randf_range(3.8, 4.8), rng.randf())
	var tex := c.texture()
	_cache["wheat_top"] = tex
	_cache["wheat_top_img"] = c.image()
	return tex


## Saves every texture as PNG (tools/glab/paint_dump.gd).
static func dump(dir: String) -> void:
	card_atlas()
	wheat_top()
	for k in ["atlas", "wheat_top"]:
		var img: Image = _cache[k + "_img"]
		img.save_png(dir.path_join(k + ".png"))


# --- composition -------------------------------------------------------------------------------------------------

## Wheat: `n` stalks rising to nodding ears with grains and long awns, leaves low down.
static func _wheat(c: Canvas, r: Rect2i, seed_value: int, n: int) -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var x0 := float(r.position.x)
	var y_bot := float(r.position.y + r.size.y) - 2.0
	var W := float(r.size.x)
	var H := float(r.size.y)
	c.rect_fill(Rect2i(r.position.x + 10, r.position.y + r.size.y - 22, r.size.x - 20, 22), Color(0.0, 0.15, 0.0, 1.0))
	var stalks: Array = []
	for i in n:
		var u := clampf(0.5 + rng.randfn(0.0, 0.24), 0.06, 0.94)
		var top := H * rng.randf_range(0.68, 0.8)
		stalks.append([rng.randf(), u, top, rng.randf_range(-0.1, 0.18) * top])
	stalks.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0])
	# Leaves (long, arching) low down.
	for i in n / 2 + 4:
		var u := rng.randf_range(0.08, 0.92)
		var h := H * rng.randf_range(0.18, 0.4)
		var lean := h * rng.randf_range(-0.8, 0.8)
		c.blade(Vector2(x0 + u * W, y_bot), h, lean, 0.0, rng.randf_range(3.0, 4.5), rng.randf_range(0.15, 0.6), r, 0.33)
	for s in stalks:
		var shade: float = 0.25 + 0.75 * float(s[0])
		var root := Vector2(x0 + float(s[1]) * W, y_bot)
		var top := root + Vector2(float(s[3]), -float(s[2]))
		c.stem(root, top, 1.5, r, shade, H)
		# The ear nods towards its lean.
		var nod := -PI * 0.5 + clampf(float(s[3]) / float(s[2]) * 2.4, -0.45, 0.6) + rng.randf_range(-0.1, 0.25)
		var L := rng.randf_range(26.0, 34.0)
		var dir := Vector2(cos(nod), sin(nod))
		for k in 8:
			var t := rng.randf_range(0.3, 1.0)
			var a2 := nod + rng.randf_range(-0.32, 0.32)
			var at := top + dir * L * t
			c.line(at, at + Vector2(cos(a2), sin(a2)) * rng.randf_range(14.0, 24.0), 0.6, Color(0.0, 0.85, 1.0, 1.0), r, H, y_bot)
		c.ear_side(top, nod, L, rng.randf_range(5.0, 6.2), shade, r, H, y_bot)


static func mix(a: float, b: float, t: float) -> float:
	return a + (b - a) * t


# --- the canvas ----------------------------------------------------------------------------------------------------

## An RGBA float canvas with the few brush primitives the paintings need. Painter's rule: a pixel takes a stroke's
## data where the stroke is solid (coverage > 0.5) or where the pixel was emptier than the stroke's soft edge.
class Canvas:
	var w: int
	var h: int
	var px: PackedFloat32Array

	func _init(width: int, height: int) -> void:
		w = width
		h = height
		px.resize(w * h * 4)
		px.fill(0.0)

	func fill(col: Color) -> void:
		for i in w * h:
			var o := i * 4
			px[o] = col.r
			px[o + 1] = col.g
			px[o + 2] = col.b
			px[o + 3] = col.a

	func rect_fill(r: Rect2i, col: Color) -> void:
		for y in range(r.position.y, r.position.y + r.size.y):
			for x in range(r.position.x, r.position.x + r.size.x):
				var o := (y * w + x) * 4
				px[o] = col.r
				px[o + 1] = col.g
				px[o + 2] = col.b
				px[o + 3] = col.a

	func put(x: int, y: int, r: float, g: float, b: float, a: float) -> void:
		if x < 0 or y < 0 or x >= w or y >= h:
			return
		var o := (y * w + x) * 4
		var old := px[o + 3]
		if a > 0.5 or old < a:
			px[o] = r
			px[o + 1] = g
			px[o + 2] = b
			px[o + 3] = maxf(old, a)

	## An upright blade from `root` (bottom), `height` px tall, the tip `lean` px to the side (a curve that bends more
	## towards the tip), `bow` px of sideways bulge mid-way, `w0` px wide at the root. R = height fraction, G = shade,
	## B = across (or `part` when part >= 0), clipped to `clip`.
	func blade(root: Vector2, height: float, lean: float, bow: float, w0: float, shade: float, clip: Rect2i, part: float = -1.0) -> void:
		if height < 2.0:
			return
		var cx0 := clip.position.x
		var cx1 := clip.position.x + clip.size.x - 1
		var y_top := maxi(int(floor(root.y - height)), clip.position.y)
		var y_bot := mini(int(ceil(root.y)), clip.position.y + clip.size.y - 1)
		for y in range(y_top, y_bot + 1):
			var t := clampf((root.y - (float(y) + 0.5)) / height, 0.0, 1.0)
			var cx := root.x + lean * pow(t, 1.7) + bow * sin(PI * t)
			var slope := (lean * 1.7 * pow(maxf(t, 0.001), 0.7) + bow * PI * cos(PI * t)) / height
			var hw := 0.5 * w0 * pow(maxf(0.0, 1.0 - pow(t, 1.4)), 0.75) * sqrt(1.0 + slope * slope) + 0.15
			var inv := 1.0 / maxf(2.0 * hw, 0.001)
			var xa := maxi(int(floor(cx - hw - 1.0)), cx0)
			var xb := mini(int(ceil(cx + hw + 1.0)), cx1)
			var row := y * w
			for x in range(xa, xb + 1):
				var dx := float(x) + 0.5 - cx
				var cov := clampf((hw - absf(dx)) * 0.6667 + 0.5, 0.0, 1.0)
				if cov <= 0.0:
					continue
				var o := (row + x) * 4
				var old := px[o + 3]
				if cov > 0.5 or old < cov:
					px[o] = t
					px[o + 1] = shade
					px[o + 2] = clampf((dx + hw) * inv, 0.0, 1.0) if part < 0.0 else part
					px[o + 3] = maxf(old, cov)

	## A thin stem from a to b (a below b), R = height in the tile (relative to `H` px from the tile bottom).
	func stem(a: Vector2, b: Vector2, hw: float, clip: Rect2i, shade: float = 0.4, H: float = 0.0) -> void:
		var tile_h := H if H > 0.0 else float(clip.size.y)
		var y_bot := float(clip.position.y + clip.size.y) - 2.0
		var y0 := maxi(int(floor(minf(a.y, b.y))), clip.position.y)
		var y1 := mini(int(ceil(maxf(a.y, b.y))), clip.position.y + clip.size.y - 1)
		for y in range(y0, y1 + 1):
			var t := clampf((a.y - (float(y) + 0.5)) / maxf(a.y - b.y, 0.001), 0.0, 1.0)
			var cx := a.x + (b.x - a.x) * t + sin(t * PI) * (b.x - a.x) * 0.15
			var r := clampf((y_bot - float(y)) / tile_h, 0.0, 1.0)
			for x in range(maxi(int(floor(cx - hw - 1.0)), clip.position.x), mini(int(ceil(cx + hw + 1.0)), clip.position.x + clip.size.x - 1) + 1):
				var cov := clampf((hw - absf(float(x) + 0.5 - cx)) / 1.2 + 0.5, 0.0, 1.0)
				if cov > 0.0:
					put(x, y, r, shade, 0.0, cov)

	## A straight thin line (awns), R recomputed as height in the tile, clipped to `clip`.
	func line(a: Vector2, b: Vector2, hw: float, col: Color, clip: Rect2i, H: float, y_bot: float) -> void:
		_seg(a, b, hw, col, clip, H, y_bot, false)

	## A straight thin line on a tiling canvas, with the data of `col`.
	func line_wrap(a: Vector2, ang: float, L: float, hw: float, col: Color) -> void:
		_seg(a, a + Vector2(cos(ang), sin(ang)) * L, hw, col, Rect2i(), 0.0, 0.0, true)

	## The line brush: marches along the segment's major axis and visits the few pixels across it once each, with
	## the exact distance to the segment (coverage = hw + 0.5 - distance, a soft 1 px edge).
	func _seg(a: Vector2, b: Vector2, hw: float, col: Color, clip: Rect2i, H: float, y_bot: float, wrap: bool) -> void:
		var dx := b.x - a.x
		var dy := b.y - a.y
		var l2 := dx * dx + dy * dy
		if l2 < 0.25:
			return
		var ext := hw + 0.5
		var x_major := absf(dx) >= absf(dy)
		var major := dx if x_major else dy
		var minor := dy if x_major else dx
		var a_maj := a.x if x_major else a.y
		var a_min := a.y if x_major else a.x
		var b_maj := b.x if x_major else b.y
		var span := ext * sqrt(1.0 + (minor / major) * (minor / major)) + 0.5
		for m in range(int(floor(minf(a_maj, b_maj) - ext)), int(ceil(maxf(a_maj, b_maj) + ext)) + 1):
			var cm := float(m) + 0.5
			var c_min := a_min + minor * clampf((cm - a_maj) / major, 0.0, 1.0)
			for n in range(int(floor(c_min - span)), int(ceil(c_min + span)) + 1):
				var x := m if x_major else n
				var y := n if x_major else m
				var px := float(x) + 0.5 - a.x
				var py := float(y) + 0.5 - a.y
				var t := clampf((px * dx + py * dy) / l2, 0.0, 1.0)
				var ex := px - dx * t
				var ey := py - dy * t
				var cov := clampf(ext - sqrt(ex * ex + ey * ey), 0.0, 1.0)
				if cov <= 0.0:
					continue
				if wrap:
					put(posmod(x, w), posmod(y, h), col.r, col.g, col.b, cov)
				elif x >= clip.position.x and y >= clip.position.y and x < clip.position.x + clip.size.x and y < clip.position.y + clip.size.y:
					put(x, y, clampf((y_bot - float(y)) / H, 0.0, 1.0), col.g, col.b, cov)

	## A wheat ear seen from above (tiling): a segmented spindle from p along ang, L long, half width hw.
	## R = position along the ear, G = grain pattern x shade, B = 0.66 (ear).
	func ear_top(p: Vector2, ang: float, L: float, hw: float, shade: float) -> void:
		var d := Vector2(cos(ang), sin(ang))
		var nrm := Vector2(-d.y, d.x)
		# the ear's own box (not a square of radius L round it): same pixels, ~10x fewer iterations
		var ext := hw + 2.0
		var e := p + d * L
		for y in range(int(floor(minf(p.y, e.y) - ext)), int(ceil(maxf(p.y, e.y) + ext)) + 1):
			for x in range(int(floor(minf(p.x, e.x) - ext)), int(ceil(maxf(p.x, e.x) + ext)) + 1):
				var q := Vector2(float(x) + 0.5, float(y) + 0.5) - p
				var t := q.dot(d) / L
				if t < 0.0 or t > 1.0:
					continue
				var prof := sin(PI * pow(t, 0.8)) * hw
				var off := q.dot(nrm)
				var cov := clampf((prof - absf(off)) / 1.0 + 0.5, 0.0, 1.0)
				if cov <= 0.0:
					continue
				var grain := 0.5 + 0.5 * cos(t * L / 3.2 * TAU + signf(off) * 1.6)
				var g := clampf(0.3 + 0.38 * grain * (0.6 + 0.4 * shade) + 0.3 * (1.0 - absf(off) / maxf(prof, 0.01)), 0.0, 1.0)
				put(posmod(x, w), posmod(y, h), t, g, 0.66, cov)

	## A wheat ear seen from the side: a segmented spindle from `base` along `ang` (canvas space, y down).
	## R = height in the tile, G = grain pattern x shade, B = 0.66.
	func ear_side(base: Vector2, ang: float, L: float, hw: float, shade: float, clip: Rect2i, H: float, y_bot: float) -> void:
		var d := Vector2(cos(ang), sin(ang))
		var nrm := Vector2(-d.y, d.x)
		# the ear's own box (not a square of radius L round it): same pixels, ~10x fewer iterations
		var ext := hw + 2.0
		var e := base + d * L
		for y in range(int(floor(minf(base.y, e.y) - ext)), int(ceil(maxf(base.y, e.y) + ext)) + 1):
			for x in range(int(floor(minf(base.x, e.x) - ext)), int(ceil(maxf(base.x, e.x) + ext)) + 1):
				if x < clip.position.x or y < clip.position.y or x >= clip.position.x + clip.size.x or y >= clip.position.y + clip.size.y:
					continue
				var q := Vector2(float(x) + 0.5, float(y) + 0.5) - base
				var t := q.dot(d) / L
				if t < 0.0 or t > 1.0:
					continue
				var prof := sin(PI * pow(t, 0.75)) * hw * (1.0 - 0.25 * t)
				var off := q.dot(nrm)
				var cov := clampf((prof - absf(off)) / 1.0 + 0.5, 0.0, 1.0)
				if cov <= 0.0:
					continue
				# Grains: alternating rows on each side of the axis, lit on one flank.
				var grain := 0.5 + 0.5 * cos(t * L / 3.8 * TAU + signf(off) * 1.6)
				var flank := 0.5 + 0.5 * signf(off) * clampf(absf(off) / maxf(prof, 0.01), 0.0, 1.0)
				var g := clampf(0.3 + 0.35 * grain + 0.3 * flank * (0.5 + 0.5 * shade), 0.0, 1.0)
				put(x, y, clampf((y_bot - float(y)) / H, 0.0, 1.0), g, 0.66, cov)

	func image() -> Image:
		var data := PackedByteArray()
		data.resize(w * h * 4)
		for i in w * h * 4:
			data[i] = int(clampf(px[i], 0.0, 1.0) * 255.0 + 0.5)
		return Image.create_from_data(w, h, false, Image.FORMAT_RGBA8, data)

	func texture() -> ImageTexture:
		var img := image()
		img.generate_mipmaps()
		return ImageTexture.create_from_image(img)
