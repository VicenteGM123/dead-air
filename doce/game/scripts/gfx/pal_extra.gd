class_name PalExtra
## A few extra named tones for the environment models, all derived from the main palette (Pal) so they sit
## inside the same "Diorama del Egeo" range. Keep this list short: prefer Pal.

## Olive bark: halfway between Pal.WOOD_DARK and Pal.ROCK_DARK (olive trunks are grey-brown, not red).
const OLIVE_BARK := Color("765E4A")
## Rock halftone between Pal.ROCK and Pal.ROCK_DARK (dry-stone walls, rubble).
const ROCK_MID := Color("A3937F")
## Wet, sea-darkened rock at the waterline (Pal.ROCK_DARK pulled towards Pal.SKIN_SHADOW).
const ROCK_WET := Color("665B54")
## Tilled earth / soil basins under orchard trees (between Pal.PATH_DARK and Pal.WOOD_LIGHT).
const SOIL := Color("A98361")
