[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="hero"
3d_physics/layer_3="enemies"
3d_physics/layer_4="movable"
3d_physics/layer_5="triggers"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.1, 0.12, 0.25, 1)
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size.web=2048

