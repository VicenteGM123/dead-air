# ALLOWLIST: only the game is published. Everything is ignored unless explicitly re-included below.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/README.md
!/package.json
!/package-lock.json
!/build/
!/src/
!/assets/
!/tools/
/tools/*
!/tools/build.mjs
!/tools/bake/
!/tools/audio/
!/godot/
!/blender/
!/godot-web/
!/builds/

# never, even inside allowed folders
.godot/
__pycache__/
*.pyc
/blender/_vendor/
/blender/out/
node_modules/
*.log
.env*
*.pem
*.key
.DS_Store
Thumbs.db
